{
  "name": "AHL WhatsApp FlexiFunnels Smart Retargeting Sync",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "79a84078-337b-44d7-9f98-ded629f37c86",
        "responseMode": "onReceived",
        "options": {}
      },
      "id": "webhook-trigger",
      "name": "Webhook",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [
        200,
        300
      ]
    },
    {
      "parameters": {
        "operation": "getRows",
        "documentId": {
          "__rl": true,
          "value": "178whhdEBgxDm1ar0SftrwSKDyO5bWeEk-o2eUCr1p74",
          "mode": "id"
        },
        "sheetName": {
          "__rl": true,
          "value": "WhatsApp Data",
          "mode": "name"
        },
        "filters": {
          "conditions": [
            {
              "keyName": "Full Phone",
              "condition": "equal",
              "value": "={{ $json.body.wa_id }}"
            }
          ]
        },
        "options": {}
      },
      "id": "search-existing-lead",
      "name": "Search Existing Lead in Sheet",
      "type": "n8n-nodes-base.googleSheets",
      "typeVersion": 4.5,
      "position": [
        450,
        300
      ],
      "alwaysOutputData": true
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": false,
            "leftValue": "",
            "typeValidation": "loose"
          },
          "conditions": [
            {
              "id": "condition-no-existing-row",
              "leftValue": "={{ $json['Full Phone'] }}",
              "rightValue": "",
              "operator": {
                "type": "string",
                "operation": "empty"
              }
            },
            {
              "id": "condition-older-than-24h",
              "leftValue": "={{ $now.diff($json.Date || $now, 'hours') }}",
              "rightValue": 24,
              "operator": {
                "type": "number",
                "operation": "gt"
              }
            },
            {
              "id": "condition-new-campaign",
              "leftValue": "={{ $('Webhook').item.json.body.vars.CampaignName || $('Webhook').item.json.body.campaign_name || '' }}",
              "rightValue": "={{ $json.CampaignName || '' }}",
              "operator": {
                "type": "string",
                "operation": "notEquals"
              }
            }
          ],
          "combinator": "or"
        }
      },
      "id": "check-retargeted-or-new",
      "name": "Is New Lead OR Retargeted (New Campaign / >24h)?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [
        720,
        300
      ]
    },
    {
      "parameters": {
        "operation": "append",
        "documentId": {
          "__rl": true,
          "value": "178whhdEBgxDm1ar0SftrwSKDyO5bWeEk-o2eUCr1p74",
          "mode": "id"
        },
        "sheetName": {
          "__rl": true,
          "value": "WhatsApp Data",
          "mode": "name"
        },
        "columns": {
          "mappingMode": "defineBelow",
          "value": {
            "Full Phone": "={{ $('Webhook').item.json.body.wa_id }}",
            "Date": "={{ $now }}",
            "Name": "={{ $('Webhook').item.json.body.vars.user_name || $('Webhook').item.json.body.name || '' }}",
            "Phone": "={{ $('Webhook').item.json.body.wa_id.toString().replace(/^91/, '') }}",
            "City": "={{ $('Webhook').item.json.body.vars.city || $('Webhook').item.json.body.city || '' }}",
            "CampaignName": "={{ $('Webhook').item.json.body.vars.CampaignName || $('Webhook').item.json.body.campaign_name || '' }}",
            "AdSetName": "={{ $('Webhook').item.json.body.vars.AdSetName || $('Webhook').item.json.body.adset_name || '' }}",
            "AdName": "={{ $('Webhook').item.json.body.vars.AdName || $('Webhook').item.json.body.ad_name || '' }}",
            "CampaignSource": "={{ $('Webhook').item.json.body.vars.CampaignSource || $('Webhook').item.json.body.campaign_source || '' }}",
            "Placement": "={{ $('Webhook').item.json.body.vars.Placement || $('Webhook').item.json.body.placement || '' }}",
            "Status": ""
          }
        },
        "options": {}
      },
      "id": "append-new-lead-row",
      "name": "Append New / Retargeted Row (Status Blank)",
      "type": "n8n-nodes-base.googleSheets",
      "typeVersion": 4.5,
      "position": [
        1020,
        180
      ]
    },
    {
      "parameters": {
        "operation": "update",
        "documentId": {
          "__rl": true,
          "value": "178whhdEBgxDm1ar0SftrwSKDyO5bWeEk-o2eUCr1p74",
          "mode": "id"
        },
        "sheetName": {
          "__rl": true,
          "value": "WhatsApp Data",
          "mode": "name"
        },
        "columns": {
          "mappingMode": "defineBelow",
          "value": {
            "Full Phone": "={{ $('Webhook').item.json.body.wa_id }}",
            "Date": "={{ $now }}",
            "Name": "={{ $('Webhook').item.json.body.vars.user_name || $('Webhook').item.json.body.name || $json.Name || '' }}",
            "City": "={{ $('Webhook').item.json.body.vars.city || $('Webhook').item.json.body.city || $json.City || '' }}",
            "Status": "={{ $json.Status || 'Sent' }}"
          },
          "matchingColumns": [
            "Full Phone"
          ]
        },
        "options": {}
      },
      "id": "update-same-session-row",
      "name": "Update Same-Session Row (Keep Sent)",
      "type": "n8n-nodes-base.googleSheets",
      "typeVersion": 4.5,
      "position": [
        1020,
        420
      ]
    }
  ],
  "connections": {
    "Webhook": {
      "main": [
        [
          {
            "node": "Search Existing Lead in Sheet",
